rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para a coleção de veículos
    match /vehicles/{vehicle} {
      // Qualquer um pode ler (para mostrar no site)
      allow read: if true;
      // Apenas usuários autenticados (admin) podem criar/editar/deletar
      allow write: if request.auth != null;
    }
    
    // Regra padrão para outras coleções (bloqueia tudo por segurança, libera apenas para admin)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
